# Copy to scripts/demo.env (gitignored) and edit. Every value has a default,
# so set only what differs.

# The repo the agent reads, relative to ~/Developer, and its GitHub slug.
DEMO_PROJECT=patchbay-go
DEMO_REPO=synodic-studio/patchbay-go

# Where auto-commit puts the note. Matches the app's default, so nothing needs
# setting on the phone. The script refuses to run if this branch already
# exists, because --cleanup deletes it.
DEMO_BRANCH=patchbay

# Any litellm alias. Pick a fast one; the whole turn happens on stage.
DEMO_MODEL=dsf

# Must match the write directory set in the app, or the commit finds nothing.
DEMO_SAVE_PATH=docs/patchbay/

# Where the server writes stderr. The brew service and the LaunchAgent both
# use this path; a foreground server needs redirecting to it.
DEMO_LOG=$HOME/Library/Logs/patchbay-voice-server.log

# Only used by --drive and --auto. Live, you ask one of DEMO_ASKS instead.
DEMO_PROMPT="Walk me through what happens when someone taps a Patchbay Go link, from the redirect through to the app opening, and save that as a note for a new contributor."

# Shown on the cue screen to pick from, one per line. Keep them to questions
# that cannot be answered from the README, so the answer proves it read code.
DEMO_ASKS="How does a link get from a chat message to the app opening?
What does the raw route refuse to redirect to, and why?
How does the key handoff keep the server from seeing the secret?"

# Set only if the server runs with VOICE_AUTH_TOKEN.
# VOICE_AUTH_TOKEN=

default_platform(:ios)

ASC_KEY_ID    = "REDACTED-ASC-KEY-ID"
ASC_ISSUER_ID = "REDACTED-ASC-ISSUER-ID"
ASC_KEY_PATH  = File.expand_path("~/.appstoreconnect/private_keys/AuthKey_REDACTED-ASC-KEY-ID.p8")

platform :ios do
  desc "Upload the already-built IPA to TestFlight (skips build)"
  lane :upload do
    api_key = app_store_connect_api_key(
      key_id: ASC_KEY_ID,
      issuer_id: ASC_ISSUER_ID,
      key_filepath: ASC_KEY_PATH,
      duration: 1200,
      in_house: false,
    )
    upload_to_testflight(
      api_key: api_key,
      ipa: "build/fastlane/PatchbayVoice.ipa",
      skip_waiting_for_build_processing: false,
      skip_submission: true,
      distribute_external: false,
      notify_external_testers: false,
    )
  end

  desc "Build and upload a new beta to TestFlight"
  lane :beta do
    sh("security unlock-keychain -p \"$(pass show mac-login-password)\" ~/Library/Keychains/login.keychain-db")
    sh("cd .. && tuist generate --no-open")

    api_key = app_store_connect_api_key(
      key_id: ASC_KEY_ID,
      issuer_id: ASC_ISSUER_ID,
      key_filepath: ASC_KEY_PATH,
      duration: 1200,
      in_house: false,
    )

    build_app(
      workspace: "PatchbayVoice.xcworkspace",
      scheme: "PatchbayVoice",
      configuration: "Release",
      export_method: "app-store",
      clean: true,
      output_directory: "build/fastlane",
      output_name: "PatchbayVoice.ipa",
      include_bitcode: false,
      include_symbols: true,
      xcargs: "-allowProvisioningUpdates DEVELOPMENT_TEAM=CX9A4TZM67",
      export_options: {
        method: "app-store",
        signingStyle: "automatic",
        teamID: "CX9A4TZM67",
      },
    )

    upload_to_testflight(
      api_key: api_key,
      ipa: "build/fastlane/PatchbayVoice.ipa",
      skip_waiting_for_build_processing: false,
      skip_submission: true,
      distribute_external: false,
      notify_external_testers: false,
    )

    asc_script = File.expand_path(
      "~/.claude/plugins/cache/synodic-kit/synodic-kit/df53c3e5f437/skills/testflight-ship/scripts/asc.py",
    )
    app_id = "6785742336"
    # Internal Testers group has hasAccessToAllBuilds=False — must be explicitly linked
    internal_testers_group_id = "9edf449a-cf4c-4cfb-b506-33348c2eb601"
    sh("uv tool run --from authlib --with httpx python3 #{asc_script} auto-notify --app-id #{app_id}")
    sh("uv tool run --from authlib --with httpx python3 #{asc_script} add-build-to-group --app-id #{app_id} --group-id #{internal_testers_group_id}")
    sh("uv tool run --from authlib --with httpx python3 #{asc_script} ensure-invited --app-id #{app_id}")
  end

  desc "Increment CURRENT_PROJECT_VERSION in Project.swift, anchored to latest TestFlight build"
  lane :bump_build do
    asc_script = File.expand_path(
      "~/.claude/plugins/cache/synodic-kit/synodic-kit/df53c3e5f437/skills/testflight-ship/scripts/asc.py",
    )
    app_id = "6785742336"
    tf_latest_str = sh(
      "uv tool run --from authlib --with httpx python3 #{asc_script} build-status --app-id #{app_id} --limit 1 2>&1 | head -1 | grep -oE 'build [0-9]+' | awk '{print $2}'",
      log: false,
    ).strip
    tf_latest = tf_latest_str.to_i

    project_path = File.expand_path("../Project.swift", __dir__)
    content = File.read(project_path)
    local_current = content[/"CURRENT_PROJECT_VERSION": "(\d+)"/, 1].to_i
    next_build = [tf_latest, local_current].max + 1
    File.write(project_path, content.sub(/"CURRENT_PROJECT_VERSION": "\d+"/, "\"CURRENT_PROJECT_VERSION\": \"#{next_build}\""))
    UI.success("Bumped build: #{local_current} → #{next_build} (TestFlight latest: #{tf_latest})")
  end
end

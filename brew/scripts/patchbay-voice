#!/bin/bash
# patchbay-voice — Run the Patchbay Voice server
# Installed by Homebrew: brew install synodic-studio/synodic/patchbay-voice-server

set -euo pipefail

PB_LIBEXEC="__LIBEXEC__"
PB_VERSION="__VERSION__"
# The keg mirrors the repo layout (server/, pi/, web/ side by side) because the
# server resolves pi/tools.ts, web/index.html and its assets relative to its own
# directory. Run from server/, not from the layout root.
PB_SERVER="$PB_LIBEXEC/server"

_discover_urls() {
    local port="${VOICE_PORT:-31552}"
    echo "━━━ Patchbay Voice Server ━━━"
    echo ""
    echo "Connect your iOS app to one of these URLs:"
    # Discovery must never abort startup: on a host with no Ethernet,
    # `ipconfig getifaddr en1` exits 1, which under `set -euo pipefail`
    # would kill the wrapper before it ever exec's uvicorn. Guard every
    # probe with `|| true`.
    if command -v ipconfig &>/dev/null; then
        local wifi eth
        wifi=$(ipconfig getifaddr en0 2>/dev/null || true); [[ -n "$wifi" ]] && echo "  http://$wifi:$port   (Wi-Fi)"
        eth=$(ipconfig getifaddr en1 2>/dev/null || true); [[ -n "$eth" ]] && echo "  http://$eth:$port   (Ethernet)"
    fi
    if command -v tailscale &>/dev/null; then
        local ts; ts=$(tailscale ip -4 2>/dev/null || true); [[ -n "$ts" ]] && echo "  http://$ts:$port     (Tailscale)"
    fi
    echo ""
    echo "Set a custom host with: VOICE_HOST=<ip> brew services restart patchbay-voice-server"
    echo "━━━━━━━━━━━━━━━━━━━━━━━━━━"
}

case "${1:-start}" in
    start)
        cd "$PB_SERVER"
        export PATH="/opt/homebrew/bin:/opt/homebrew/sbin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin"
        _discover_urls
        exec uv run uvicorn app:app \
            --host "${VOICE_HOST:-127.0.0.1}" \
            --port "${VOICE_PORT:-31552}" \
            --log-level info
        ;;
    status)
        if brew services list 2>/dev/null | grep -q "patchbay-voice-server.*started"; then
            echo "Running (brew services)"; _discover_urls
        elif launchctl list | grep -q "com.synodic.patchbay-voice-server"; then
            echo "Running"; _discover_urls
        else echo "Not running"; fi
        ;;
    logs) exec tail -f "${HOME}/Library/Logs/patchbay-voice-server.log" ;;
    urls) _discover_urls ;;
    qr)
        # Print a setup QR (and deep link) so the app can be configured by
        # scanning — no typing the URL or token. Optional arg overrides the URL.
        cd "$PB_SERVER"
        export PATH="/opt/homebrew/bin:/opt/homebrew/sbin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin"
        export PB_WIFI="$(ipconfig getifaddr en0 2>/dev/null || true)"
        command -v tailscale &>/dev/null && export PB_TAILSCALE="$(tailscale ip -4 2>/dev/null | head -1 || true)"
        exec uv run python qr_setup.py "${2:-}"
        ;;
    version) echo "Patchbay Voice Server ${PB_VERSION:-development}" ;;
    help|--help|-h|*)
        echo "Usage: patchbay-voice <start|status|logs|urls|qr|version>"
        echo "  start    Start the server (foreground)"
        echo "  status   Show server status and connection URLs"
        echo "  logs     Tail the server log"
        echo "  urls     Show connection URLs for the iOS app"
        echo "  qr [url] Print a setup QR code to configure the app by scanning"
        echo "  version  Print version"
        ;;
esac
